{
  "version": "1.1.0",
  "source": "design-system/05-patterns",
  "patterns": {
    "dashboard": {
      "documentation": "design-system/05-patterns/dashboard-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "primaryMetric",
        "secondaryKpiGroup",
        "watchlistOrActionList",
        "statusOrRiskBlock",
        "nextAction"
      ],
      "recommendedComponents": [
        "Screen",
        "Card",
        "Metric",
        "StatusPill",
        "GlobalMenuList",
        "FundActionGrid"
      ],
      "requiredStates": [
        "loading",
        "empty",
        "error",
        "restricted"
      ],
      "forbidden": [
        "Do not build marketing-style hero pages for operational dashboards."
      ]
    },
    "form": {
      "documentation": "design-system/05-patterns/form-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
