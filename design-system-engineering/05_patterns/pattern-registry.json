{
  "version": "1.1.0",
  "source": "design-system/05-patterns",
  "patterns": {
    "dashboard": {
      "documentation": "design-system/05-patterns/dashboard-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "primaryMetric",
        "secondaryKpiGroup",
        "watchlistOrActionList",
        "statusOrRiskBlock",
        "nextAction"
      ],
      "recommendedComponents": [
        "Screen",
        "Card",
        "Metric",
        "StatusPill",
        "GlobalMenuList",
        "FundActionGrid"
      ],
      "requiredStates": [
        "loading",
        "empty",
        "error",
        "restricted"
      ],
      "forbidden": [
        "Do not build marketing-style hero pages for operational dashboards."
      ]
    },
    "form": {
      "documentation": "design-system/05-patterns/form-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "goalAndRiskContext",
        "labeledFields",
        "inlineValidation",
        "visibleSubmitAction",
        "successAndFailureFeedback",
        "fieldSpec"
      ],
      "recommendedComponents": [
        "Screen",
        "TextField",
        "ActionButton",
        "StatusPill"
      ],
      "requiredStates": [
        "default",
        "focused",
        "error",
        "disabled",
        "submitting",
        "success"
      ],
      "forbidden": [
        "Do not hide validation or risk copy to simplify layout."
      ]
    },
    "list": {
      "documentation": "design-system/05-patterns/list-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "headerWithOptionalFilter",
        "governedRows",
        "loadingSkeleton",
        "emptyState",
        "errorState"
      ],
      "recommendedComponents": [
        "Screen",
        "Card",
        "GlobalMenuList",
        "EmptyState",
        "SegmentedTabs"
      ],
      "requiredStates": [
        "loading",
        "empty",
        "error",
        "filtered",
        "selected"
      ],
      "forbidden": [
        "Do not create page-local row components when a registered row pattern exists."
      ]
    },
    "detail": {
      "documentation": "design-system/05-patterns/detail-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "identityHeader",
        "keyValueSummary",
        "statusHistory",
        "primaryActions",
        "riskOrComplianceNotes"
      ],
      "recommendedComponents": [
        "Screen",
        "KeyValueList",
        "StatusPill",
        "ActionButton"
      ],
      "requiredStates": [
        "loading",
        "notFound",
        "restricted",
        "error"
      ],
      "forbidden": [
        "Do not omit status and permission context for financial details."
      ]
    },
    "emptyError": {
      "documentation": "design-system/05-patterns/empty-error-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "requiredStructure": [
        "stateIcon",
        "clearTitle",
        "recoveryCopy",
        "nextAction"
      ],
      "recommendedComponents": [
        "EmptyState",
        "ActionButton",
        "AppIcon"
      ],
      "requiredStates": [
        "empty",
        "error",
        "offline",
        "restricted"
      ],
      "forbidden": [
        "Do not dead-end the user without a recovery action."
      ]
    },
    "onboarding": {
      "documentation": "design-system/05-patterns/onboarding-pattern.md",
      "platforms": [
        "app",
        "h5"
      ],
      "requiredStructure": [
        "progressContext",
        "singleStepFocus",
        "riskCopy",
        "primaryAction",
        "secondaryExit"
      ],
      "recommendedComponents": [
        "AuthShell",
        "TextField",
        "ActionButton"
      ],
      "requiredStates": [
        "default",
        "validationError",
        "submitting",
        "blocked",
        "complete"
      ],
      "forbidden": [
        "Do not imply account approval before verification is complete."
      ]
    },
    "review": {
      "documentation": "design-system/05-patterns/review-pattern.md",
      "platforms": [
        "app",
        "h5",
        "web",
        "admin"
      ],
      "requiredStructure": [
        "submittedData",
        "reviewStatus",
        "decisionReason",
        "nextStep",
        "supportPath"
      ],
      "recommendedComponents": [
        "Screen",
        "StatusPill",
        "KeyValueList",
        "ActionButton"
      ],
      "requiredStates": [
        "pending",
        "approved",
        "rejected",
        "needsAction"
      ],
      "forbidden": [
        "Do not weaken compliance or rejection reasons."
      ]
    },
    "accountContextSwitcher": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#trading-account-context-switcher",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "patternType": "dialog_pattern",
      "requiredStructure": [
        "currentAccountIdentity",
        "statusAndServerContext",
        "selectableAccountList",
        "addAccountFeedback",
        "dismissOrBackBehavior"
      ],
      "recommendedComponents": [
        "BottomSheet",
        "TradingAccountSwitchSheet",
        "AppIcon",
        "StatusPill",
        "Toast"
      ],
      "requiredStates": [
        "default",
        "selected",
        "empty",
        "restricted",
        "feedback"
      ],
      "forbidden": [
        "Do not rebuild account switcher rows inside individual pages.",
        "Do not hide account status or server context."
      ]
    },
    "tradingOrderActionSheet": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#order-position-sheets",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "patternType": "dialog_pattern",
      "requiredStructure": [
        "instrumentIdentity",
        "directionAndQuantity",
        "priceOrRange",
        "actionMenu",
        "feedbackOrConfirmation",
        "recoveryPath"
      ],
      "recommendedComponents": [
        "BottomSheet",
        "TradeOrderList",
        "TradeDirectionIcon",
        "KeyValueList",
        "ConfirmActionSheet",
        "Toast"
      ],
      "requiredStates": [
        "position-detail",
        "pending-order-detail",
        "history-detail",
        "cannot-edit",
        "confirming",
        "success",
        "failed"
      ],
      "forbidden": [
        "Do not use Alert.alert or window.confirm.",
        "Do not place high-risk mutation copy outside i18n/copy-table governance."
      ]
    },
    "metricCluster": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#metric-cluster",
      "platforms": [
        "app",
        "h5",
        "web",
        "admin"
      ],
      "patternType": "data_pattern",
      "requiredStructure": [
        "metricLabel",
        "metricValue",
        "optionalTone",
        "periodOrUnitContext",
        "emptyFallback"
      ],
      "recommendedComponents": [
        "Metric",
        "MiniMetric",
        "Card",
        "StatusPill"
      ],
      "requiredStates": [
        "default",
        "positive",
        "negative",
        "neutral",
        "loading",
        "empty"
      ],
      "forbidden": [
        "Do not create page-local KPI grid styles when MetricCluster applies.",
        "Do not omit unit or period context for financial metrics."
      ]
    },
    "financialVisualization": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#financial-chart-and-risk-gauge",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "patternType": "data_pattern",
      "requiredStructure": [
        "textualValueSummary",
        "chartOrGauge",
        "axisOrThresholdLabels",
        "riskOrTrendTone",
        "accessibilitySummary"
      ],
      "recommendedComponents": [
        "Sparkline",
        "MiniBarChart",
        "FinancialTrendChart",
        "RiskGauge",
        "AppText"
      ],
      "requiredStates": [
        "default",
        "empty",
        "positive",
        "negative",
        "warning",
        "danger"
      ],
      "forbidden": [
        "Do not communicate financial risk by color only.",
        "Do not keep reusable SVG data visualization inside pages after migration."
      ]
    },
    "discoverProfileCommerce": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#discover-profile-and-partner-cards",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "patternType": "page_pattern",
      "requiredStructure": [
        "profileIdentity",
        "verificationStatus",
        "partnerSummary",
        "rewardSummary",
        "supportOrRelationshipManager",
        "roleAwareActions"
      ],
      "recommendedComponents": [
        "ProfileAvatar",
        "StatusPill",
        "GlobalMenuList",
        "PartnerPortalSummary",
        "RewardSummaryCard",
        "VerificationStatusCard",
        "UpgradeChatCard"
      ],
      "requiredStates": [
        "guest",
        "trader",
        "partner",
        "pending",
        "restricted"
      ],
      "forbidden": [
        "Do not duplicate partner or reward cards inside Discover pages.",
        "Do not use page-local bilingual copy for financial reward surfaces."
      ]
    },
    "appearanceThemePreview": {
      "documentation": "design-system-engineering/11_public_resources/registry/migration-plan.md#theme-preview-selector",
      "platforms": [
        "app",
        "h5",
        "web"
      ],
      "patternType": "state_pattern",
      "requiredStructure": [
        "modeOption",
        "tokenPreview",
        "selectedState",
        "helperCopy"
      ],
      "recommendedComponents": [
        "Screen",
        "Card",
        "StatusPill",
        "ThemePreviewSelector"
      ],
      "requiredStates": [
        "system",
        "light",
        "dark",
        "selected",
        "unselected"
      ],
      "forbidden": [
        "Do not hardcode theme preview colors outside token preview mapping."
      ]
    }
  }
}
