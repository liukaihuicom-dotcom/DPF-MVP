{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Dupoin design token index. Color tokens are maintained in tokens.color.json; runtime non-color tokens are maintained in src/theme/tokens.ts and mapped here for governance.",
  "version": "2.0.0",
  "sources": {
    "color": "packages/design-tokens/registry/tokens.color.json",
    "modeMatrix": "packages/design-tokens/registry/token-mode.matrix.json",
    "runtime": "packages/design-tokens/src/tokens.ts",
    "runtimeCompatibility": "src/theme/tokens.ts",
    "documentation": "design-system/01-tokens"
  },
  "tokenLayers": {
    "L1": {
      "name": "primitive",
      "pageDirectUse": false,
      "description": "Raw color ramps and base numeric values."
    },
    "L2": {
      "name": "semantic",
      "pageDirectUse": true,
      "description": "Surface, text, border, status, market, chart, overlay, and brand aliases."
    },
    "L3": {
      "name": "component",
      "pageDirectUse": false,
      "description": "Component-level bindings consumed through component APIs."
    }
  },
  "families": [
    "color",
    "spacing",
    "radius",
    "shadow",
    "typography",
    "size",
    "lineWidth",
    "motion",
    "zIndex",
    "breakpoint"
  ],
  "titleRoleMap": {
    "page": "typography.displayXl",
    "pageCompact": "typography.displayLg",
    "dialog": "typography.sheetTitle",
    "sheet": "typography.sheetTitle",
    "card": "typography.titleMd",
    "section": "typography.titleMd",
    "list": "typography.caption",
    "listItem": "typography.titleMd",
    "tabs": "typography.caption",
    "bottomTabs": "typography.microLabel"
  },
  "bodyRoleMap": {
    "primary": "typography.bodyMd",
    "secondary": "typography.bodySm",
    "dense": "typography.bodySm",
    "prominent": "typography.bodyLg"
  },
  "labelRoleMap": {
    "default": "typography.caption",
    "helper": "typography.captionSm",
    "metadata": "typography.captionSm",
    "field": "typography.bodySm",
    "control": "typography.caption",
    "controlLarge": "typography.titleSm",
    "metric": "typography.captionRegular",
    "status": "typography.microLabel",
    "minimum": "typography.microMeta"
  },
  "iconSizeRoleMap": {
    "nano": "size.icon.nano / 8",
    "micro": "size.icon.micro / 12",
    "xs": "size.icon.xs / 16",
    "sm": "size.icon.sm / 20",
    "md": "size.icon.md / 24",
    "lg": "size.icon.lg / 32",
    "xl": "size.icon.xl / 40",
    "xxl": "size.icon.xxl / 48",
    "display": "size.icon.display / 64"
  },
  "iconSurfaceRoleMap": {
    "micro": "12px icon / 20px container",
    "xs": "16px icon / 28px container",
    "sm": "20px icon / 32px container",
    "md": "24px icon / 40px container",
    "lg": "32px icon / 48px container",
    "xl": "40px icon / 64px container"
  },
  "iconSurfaceToneRule": {
    "singleToneControls": [
      "iconColor",
      "backgroundColor"
    ],
    "background": {
      "visible": "Paint same-family subtle background",
      "hidden": "Keep width and height but paint transparent background"
    },
    "border": "not supported",
    "menuDisclosure": "pure 16px tertiary AppIcon without background"
  },
  "tabSizeRoleMap": {
    "barHeight": "size.tab.barHeight / 68",
    "icon": "size.tab.icon / 20",
    "indicatorHeight": "size.tab.indicatorHeight / 2",
    "indicatorWidth": "size.tab.indicatorWidth / 64",
    "itemMinHeight": "size.tab.itemMinHeight / 44",
    "pillMinHeight": "size.tab.pillMinHeight / 40",
    "underlineMinHeight": "size.tab.underlineMinHeight / 56"
  },
  "spacingScale": {
    "space.0": "spacing.none / 0",
    "space.2": "spacing.xxs / 2",
    "space.4": "spacing.xs / 4",
    "space.8": "spacing.sm / 8",
    "space.12": "spacing.md / 12",
    "space.16": "spacing.lg / 16",
    "space.24": "spacing.xl / 24",
    "space.32": "spacing.xxl / 32",
    "space.48": "spacing.section / 48"
  },
  "semanticSpacingRoleMap": {
    "screenPaddingX": "layout.screenPaddingX / 16",
    "screenGap": "layout.screenGap / 12",
    "screenBottomPadding": "layout.screenBottomPadding / 32 + device bottom safe-area inset in Screen",
    "moduleGap": "layout.moduleGap / 12",
    "sectionGap": "layout.sectionGap / 24",
    "sectionGapLarge": "layout.sectionGapLarge / 32",
    "cardPaddingX": "layout.cardPaddingX / 12 full-site default card horizontal content inset",
    "cardPaddingY": "layout.cardPaddingY / 16 full-site default card vertical content inset",
    "cardPaddingCompactX": "layout.cardPaddingCompactX / 12 compact card horizontal content inset",
    "cardPaddingCompactY": "layout.cardPaddingCompactY / 12 compact card vertical content inset",
    "cardPadding": "layout.cardPadding / 16 legacy scalar alias; use layout.cardPaddingX + layout.cardPaddingY for new card implementations",
    "cardPaddingCompact": "layout.cardPaddingCompact / 12 legacy scalar alias; use layout.cardPaddingCompactX + layout.cardPaddingCompactY for new compact card implementations",
    "bottomActionArea.contentInset": "layout.bottomActionArea.contentInset / 148",
    "bottomActionArea.gap": "layout.bottomActionArea.gap / 8",
    "bottomActionArea.keyboardContentInset": "layout.bottomActionArea.keyboardContentInset / 96",
    "bottomActionArea.keyboardPaddingBottom": "layout.bottomActionArea.keyboardPaddingBottom / 8",
    "bottomActionArea.paddingBottom": "layout.bottomActionArea.paddingBottom / 24",
    "bottomActionArea.paddingTop": "layout.bottomActionArea.paddingTop / 16",
    "bottomActionArea.paddingX": "layout.bottomActionArea.paddingX / 16",
    "listRowPaddingX": "layout.listRowPaddingX / 16",
    "listRowPaddingY": "layout.listRowPaddingY / 12",
    "formFieldTextInset": "layout.formFieldTextInset / 12",
    "formGroupGap": "layout.formGroupGap / 12",
    "fieldGap": "layout.fieldGap / 8",
    "inlineGap": "layout.inlineGap / 4",
    "controlGap": "layout.controlGap / 8",
    "sheetContentGap": "layout.sheetContentGap / 12",
    "sheetFooterGap": "layout.sheetFooterGap / 12",
    "quoteGroupGap": "layout.quoteGroupGap / 8",
    "dataRowGap": "layout.dataRowGap / 4"
  },
  "spacingGovernanceRule": {
    "baseScaleExpansion": "review-required",
    "pageLocalSpacing": "blocked",
    "preferredPageAPI": "layout.* semantic spacing tokens",
    "legacyBaseline": "shrink-only"
  },
  "minimumTextRule": {
    "minFontSize": 10,
    "allowedRoles": [
      "label.minimum"
    ]
  },
  "requiredModes": [
    "darkTerminal"
  ],
  "releaseStatus": "active",
  "package": "@dpf/design-tokens"
}
