{
  "route_policy": "Runtime route inventory for the Expo Router app. The code source of truth is src/navigation/routeRegistry.ts.",
  "source_of_truth": "src/navigation/routeRegistry.ts",
  "runtime": {
    "expo_sdk": "54",
    "router": "expo-router 6 JavaScript Tabs",
    "root_stack": "app/_layout.tsx",
    "tab_layout": "app/(tabs)/_layout.tsx"
  },
  "app_routes": {
    "index_redirect": "/",
    "brand_splash": "/brand-splash",
    "launch": "/launch",
    "workspace": "/workspace",
    "learn": "/learn",
    "demo": "/demo",
    "markets": "/markets",
    "markets_account_demo": "/markets-account-demo",
    "trade": "/trade",
    "accounts": "/accounts",
    "discover": "/discover",
    "quick": "/quick",
    "clients": "/clients",
    "growth": "/growth",
    "wallet": "/wallet",
    "me": "/me",
    "portfolio_alias": "/portfolio",
    "account_alias": "/account",
    "instrument_detail": "/instrument/[id]",
    "order_ticket": "/order/[id]",
    "client_profile": "/client/[id]",
    "partner_tools": "/partner-tools",
    "partner_client_orders": "/partner/client-orders",
    "partner_commission": "/partner/commission",
    "discover_entry": "/discover-entry/[id]",
    "discover_layout": "/discover-layout",
    "account_details": "/account-details/[id]",
    "account_basic": "/account-basic/[id]",
    "account_balance": "/account-balance/[id]",
    "account_orders": "/account-orders/[id]",
    "funding_home": "/funding",
    "deposit_form": "/funding/deposit",
    "withdrawal_form": "/funding/withdrawal",
    "transfer_form": "/funding/transfer",
    "funding_transaction_list": "/funding/transactions",
    "funding_transaction_detail": "/funding/transactions/[id]",
    "settings": "/settings",
    "security_login_log": "/settings/security-log",
    "appearance": "/appearance",
    "onboarding": "/auth/onboarding",
    "login": "/auth",
    "register_phone": "/auth/register",
    "register_email_code": "/auth/register-email-code",
    "register_email": "/auth/register-phone",
    "register_phone_code": "/auth/register-phone-code",
    "register_password": "/auth/register-password",
    "forgot_password": "/auth/forgot-password",
    "pin_setup": "/auth/pin-setup",
    "verify_legacy_redirect": "/auth/verify",
    "not_found": "/(not-found)"
  },
  "workspace_bottom_tabs": {
    "segments": {
      "new_trader": [
        "/workspace",
        "/markets",
        "/trade",
        "/accounts",
        "/discover",
        "/quick"
      ],
      "kyc_approved_no_deposit": [
        "/workspace",
        "/markets",
        "/trade",
        "/accounts",
        "/discover",
        "/quick"
      ],
      "active_trader": [
        "/workspace",
        "/markets",
        "/trade",
        "/accounts",
        "/discover",
        "/quick"
      ],
      "partner_mode": [
        "/workspace",
        "/clients",
        "/growth",
        "/wallet",
        "/me"
      ]
    },
    "hidden_by_href_null": true
  },
  "routeable_modals": {
    "order_ticket": {
      "path": "/order/[id]",
      "presentation": "transparentModal",
      "risk_level": "high",
      "reason": "Trading ticket is a transaction flow that benefits from refresh recovery, deep links, and external task entry."
    },
    "discover_layout": {
      "path": "/discover-layout",
      "presentation": "transparentModal",
      "risk_level": "low",
      "reason": "Current route-backed configuration layer; consider demoting if deep link or recovery is not required."
    }
  },
  "hidden_tab_routes": {
    "portfolio_alias": "/portfolio",
    "account_alias": "/account"
  },
  "legacy_or_compatibility_routes": {
    "index_redirect": "/",
    "verify_legacy_redirect": "/auth/verify"
  },
  "planned_routes": {
    "app_security_center": {
      "path": "/settings/security-center",
      "status": "contract_first_not_in_runtime_route_registry",
      "required_before_runtime": [
        "Add thin app/settings/security-center.tsx wrapper",
        "Add SecurityCenterScreen runtime implementation",
        "Add routeRegistry and RootLayout entries",
        "Update public-resource graph pages/readiness rows after route exists"
      ]
    }
  },
  "governance_rules": [
    "Every app/**/*.tsx product page must be registered in src/navigation/routeRegistry.ts.",
    "Workspace tabs are role-segment driven: all non-Partner Trader segments expose Workspace, Markets, Trade, Accounts, Discover, and the dynamic /quick Discover carrier; disallowed routes remain hidden with href null.",
    "Partner client orders and commission wallet are Partner mode tabs and must not replace Trader /trade or /accounts.",
    "Security Center canonical route /settings/security-center is planned contract-first and must be added to src/navigation/routeRegistry.ts only during the App implementation stage."
  ]
}
